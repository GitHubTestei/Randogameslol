-- Reflectance (skips local player's entire character)
local function getCharacterParts()
    local parts = {}
    if localPlayer.Character then
        for _, v in pairs(localPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                parts[v] = true
            end
        end
    end
    return parts
end

local function applyReflectance()
    local charParts = getCharacterParts()
    for _, v in pairs(ws:GetDescendants()) do
        if v:IsA("BasePart") and not charParts[v] then
            v.Reflectance = 0.3
        end
    end
end

applyReflectance()

ws.DescendantAdded:Connect(function(v)
    task.wait()
    if v:IsA("BasePart") then
        local charParts = getCharacterParts()
        if not charParts[v] then
            v.Reflectance = 0.3
        end
    end
end)

localPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    applyReflectance()
end)

print("Evening shader applied.")
