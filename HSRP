        checkmark.TextColor3 = Color3.fromRGB(100, 180, 255)
        checkmark.Font = Enum.Font.GothamBold
        checkmark.TextSize = 13
        checkmark.Text = ""
        checkmark.Parent = checkbox
        local label = Instance.new("TextLabel")
