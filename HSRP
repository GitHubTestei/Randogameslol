    local friendsCount = Instance.new("TextLabel")
    friendsCount.Size = UDim2.new(1, -10, 0, 14)
    friendsCount.BackgroundTransparency = 1
    friendsCount.TextColor3 = Color3.fromRGB(100, 255, 100)
    friendsCount.Font = Enum.Font.GothamBold
    friendsCount.TextSize = 10
    friendsCount.Text = "Protected Friends: 0"
    friendsCount.ZIndex = 4
    friendsCount.Parent = FriendsSection

    local function parseFriends(text)
        FriendsNamesList = {}
        for name in text:gmatch("%S+") do
            table.insert(FriendsNamesList, name:lower())
        end
        friendsCount.Text = "Protected Friends: " .. #FriendsNamesList
    end

    friendsText:GetPropertyChangedSignal("Text"):Connect(function()
        parseFriends(friendsText.Text)
    end)

    local function isFriend(name)
        local ln = name:lower()
        for _, f in ipairs(FriendsNamesList) do
            if ln:find(f, 1, true) then return true end
        end
        return false
    end

    -- Hitbox loop
    RunService.RenderStepped:Connect(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not player.Character then continue end

            pcall(function()
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                if isFriend(player.Name) or isFriend(player.DisplayName) then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.Material = Enum.Material.Plastic
                    hrp.CanCollide = false
                    return
                end

                if not HitboxEnabled then
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.Material = Enum.Material.Plastic
                    hrp.CanCollide = false
                    return
                end

                hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                hrp.CanCollide = false

                if HitboxVisible then
                    hrp.Transparency = 0.7
                    hrp.Material = Enum.Material.Neon
                    hrp.BrickColor = BrickColor.new("White")
                else
                    hrp.Transparency = 1
                    hrp.Material = Enum.Material.Plastic
                end
            end)
        end
    end)

    -- KillAura
    local RE = {HitRemote = nil, PunchDoRemote = nil}

    task.spawn(function()
        task.wait(1)
        pcall(function()
            RE.HitRemote = ReplicatedStorage.Packages.Knit.Services.CombatService.RF.Hit
            RE.PunchDoRemote = ReplicatedStorage.Packages.Knit.Services.CombatService.RF.PunchDo
        end)
    end)

    local auraLoop
    local lastAttack = 0

    function startKillAura()
        if auraLoop then auraLoop:Disconnect() end
        lastAttack = 0

        auraLoop = RunService.Heartbeat:Connect(function()
            if not KillAuraEnabled or ScriptUnloaded then return end

            local now = tick()
            if now - lastAttack < (1 / AttacksPerSecond) then return end

            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local myPos = char.HumanoidRootPart.Position

            local targets = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer or not plr.Character then continue end
                if isFriend(plr.Name) or isFriend(plr.DisplayName) then continue end

                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist <= KillAuraRange then
                        table.insert(targets, {char = plr.Character, dist = dist})
                    end
                end
            end

            table.sort(targets, function(a,b) return a.dist < b.dist end)

            if #targets == 0 then return end

            lastAttack = now

            for _, t in ipairs(targets) do
                task.spawn(function()
                    pcall(function()
                        if RE.PunchDoRemote then RE.PunchDoRemote:InvokeServer() end
                    end)
                    task.wait(0.01)
                    pcall(function()
                        local hum = t.char:FindFirstChildOfClass("Humanoid")
                        if hum and RE.HitRemote then RE.HitRemote:InvokeServer(hum) end
                    end)
                end)
            end
        end)
    end

    function stopKillAura()
        if auraLoop then auraLoop:Disconnect() auraLoop = nil end
    end

    safeConnect(UserInputService.InputBegan, function(input, gp)
        if gp then return end
        for k, data in pairs(ToggleCallbacks) do
            local kc = data.getKey and data.getKey()
            if kc and input.KeyCode == kc then
                data.toggle()
            end
        end
    end)
end
