    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.Parent = row
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)
    local ts = Instance.new("UIStroke", toggleBtn)
    ts.Color = color
    ts.Thickness = 1
    ts.Transparency = 0.7

    -- Keybind button
    local kbLabel = keybinds[keybindKey] and ("[" .. keybinds[keybindKey].Name .. "]") or "[NONE]"
    local keybindBtn = Instance.new("TextButton")
    keybindBtn.Size = UDim2.new(0.52, -2, 0, 24)
    keybindBtn.Position = UDim2.new(0.48, 2, 0, 36)
    keybindBtn.BackgroundColor3 = Color3.fromRGB(10, 20, 32)
    keybindBtn.BorderSizePixel = 0
    keybindBtn.Text = "KEY: " .. kbLabel
    keybindBtn.TextColor3 = Color3.fromRGB(210, 210, 210)
    keybindBtn.TextSize = 10
    keybindBtn.Font = Enum.Font.GothamBold
    keybindBtn.Parent = row
    Instance.new("UICorner", keybindBtn).CornerRadius = UDim.new(0, 4)
    local ks = Instance.new("UIStroke", keybindBtn)
    ks.Color = Color3.fromRGB(100, 100, 110)
    ks.Thickness = 1

    local divider = Instance.new("Frame")
    divider.Size = UDim2.new(1, 0, 0, 1)
    divider.Position = UDim2.new(0, 0, 1, -1)
    divider.BackgroundColor3 = Color3.fromRGB(18, 28, 38)
    divider.BorderSizePixel = 0
    divider.Parent = row

    local isActive = false

    local function setActive(val)
        isActive = val
        if val then
            -- turn off the other click mode if it's active
            local otherKey = clickModeKey == "target" and "friend" or "target"
            if clickMode == otherKey and clickBtnRefs[otherKey] then
                clickBtnRefs[otherKey].setActive(false)
            end
            clickMode = clickModeKey
            toggleBtn.BackgroundColor3 = color
            toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            toggleBtn.Text = "ON"
        else
            if clickMode == clickModeKey then clickMode = nil end
            toggleBtn.BackgroundColor3 = Color3.fromRGB(20, 30, 42)
            toggleBtn.TextColor3 = Color3.fromRGB(100, 130, 160)
            toggleBtn.Text = "OFF"
        end
    end

    toggleBtn.MouseButton1Click:Connect(function()
        setActive(not isActive)
    end)

    keybindBtn.MouseButton1Click:Connect(function()
        settingKeybind = keybindKey
        keybindBtn.Text = "PRESS A KEY..."
        keybindBtn.TextColor3 = Color3.fromRGB(255, 200, 0)
    end)

    clickBtnRefs[clickModeKey] = {
        setActive  = setActive,
        keybindBtn = keybindBtn,
    }
end

