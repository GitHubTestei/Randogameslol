UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- Setting a keybind
    if settingKeybind then
        keybinds[settingKeybind] = input.KeyCode
        -- update the right button label
        local ref = rows[settingKeybind]
        if ref then
            ref.keybindBtn.Text = "KEYBIND: [" .. input.KeyCode.Name .. "]"
            ref.keybindBtn.TextColor3 = Color3.fromRGB(210, 210, 210)
        end
        local cref = clickBtnRefs[settingKeybind == "clickAddTarget" and "target" or settingKeybind == "clickAddFriend" and "friend" or ""]
        if cref then
            cref.keybindBtn.Text = "KEY: [" .. input.KeyCode.Name .. "]"
            cref.keybindBtn.TextColor3 = Color3.fromRGB(210, 210, 210)
        end
        settingKeybind = nil
        saveConfig()
        return
    end

    -- Hide/show GUI
    if input.KeyCode == Enum.KeyCode.LeftControl then
        toggleGui()
        return
    end

    -- Feature keybinds
    for featureKey, keyCode in pairs(keybinds) do
        if keyCode and input.KeyCode == keyCode then
            if featureKey == "clickAddTarget" then
                local ref = clickBtnRefs["target"]
                if ref then ref.setActive(clickMode ~= "target") end
            elseif featureKey == "clickAddFriend" then
                local ref = clickBtnRefs["friend"]
                if ref then ref.setActive(clickMode ~= "friend") end
            elseif state[featureKey] ~= nil then
                state[featureKey] = not state[featureKey]
                rows[featureKey].updateToggle()
            end
        end
    end
end)

-- =====================
--   FIGHT ZONE CHECK
-- =====================
local function isInFightZone(character)
    local zoneTrigger = workspace:FindFirstChild("Map")
        and workspace.Map:FindFirstChild("Building")
        and workspace.Map.Building:FindFirstChild("Building")
        and workspace.Map.Building.Building:FindFirstChild("FightZone")
        and workspace.Map.Building.Building.FightZone:FindFirstChild("ZoneTrigger")
    if not zoneTrigger then return false end
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local rel = character.HumanoidRootPart.Position - zoneTrigger.Position
    local s = zoneTrigger.Size
    return math.abs(rel.X) <= s.X/2 and math.abs(rel.Y) <= s.Y/2 and math.abs(rel.Z) <= s.Z/2
end

-- =====================
--   SHOULD ATTACK
-- =====================
local function shouldAttack(player)
    if isFriend(player) then return false end
    if #targetsList > 0 then return isTarget(player) end
    return true
end

-- =====================
--   DEATH TP
-- =====================
localPlayer.CharacterAdded:Connect(function(character)
    -- Setup: save position on death
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    humanoid.Died:Connect(function()
        if state.deathTP then
            deathPosition = rootPart.Position
        end
    end)

    -- TP: if we have a saved position, teleport immediately on spawn
    if state.deathTP and deathPosition then
        rootPart.CFrame = CFrame.new(deathPosition)
    end
end)

-- Also set up on the current character if already spawned
if localPlayer.Character then
    local character = localPlayer.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if humanoid and rootPart then
        humanoid.Died:Connect(function()
            if state.deathTP then
                deathPosition = rootPart.Position
            end
        end)
    end
end

-- =====================
--   MAIN LOOP
-- =====================
RunService.Heartbeat:Connect(function()
    local character = localPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if state.killAura then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0
                and isInFightZone(player.Character) and shouldAttack(player) then
                    for _ = 1, 20 do
                        ReplicatedStorage.FightHandler.PunchEvent:FireServer(unpack({
                            [1] = { ["Frame"] = rootPart.CFrame, ["Params"] = nil, ["Size"] = Vector3.new(7,7,7) },
                            [2] = { [1] = player.Character },
                            [3] = true
                        }))
                    end
                end
            end
        end
    end

    if state.autoBlock then
        ReplicatedStorage.FightHandler.Block:FireServer(true)
    end
end)

