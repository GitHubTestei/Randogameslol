-- Material overhaul helpers
local glassMaterials = {
    Enum.Material.Concrete,
    Enum.Material.Brick,
    Enum.Material.Plaster,
    Enum.Material.Pavement,
    Enum.Material.Wood,
}

local function isGlassMaterial(material)
    for _, m in pairs(glassMaterials) do
        if material == m then return true end
    end
    return false
end

local function isCharacterPart(part)
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and part:IsDescendantOf(player.Character) then
            return true
        end
    end
    return false
end

-- Apply reflectance + material overhaul to a single part
local function applyTopart(v)
    if not v:IsA("BasePart") or isCharacterPart(v) then return end

    if isGlassMaterial(v.Material) then
        v.Material = Enum.Material.Glass
        v.Reflectance = 0.5
    elseif v.Material == Enum.Material.Carpet then
        v.Material = Enum.Material.Glass
        v.Reflectance = 0.3
    elseif v.Material == Enum.Material.Plastic and v.Transparency == 0 then
        v.Transparency = random:NextNumber(0.1, 0.3)
    else
        v.Reflectance = 0.3
    end
end

-- Apply to all existing parts
local count = 0
for _, v in pairs(ws:GetDescendants()) do
    if v:IsA("BasePart") and not isCharacterPart(v) then
        applyTopart(v)
        count += 1
    end
end
print("Done. Changed " .. count .. " parts.")

-- Apply to new parts as they're added
ws.DescendantAdded:Connect(function(v)
    task.wait()
    applyTopart(v)
end)

-- Reapply to world (not character) when character respawns
localPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    for _, v in pairs(ws:GetDescendants()) do
        if v:IsA("BasePart") and not isCharacterPart(v) then
            applyTopart(v)
        end
    end
end)

print("Evening shader applied.")
