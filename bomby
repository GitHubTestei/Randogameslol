local function getUserIdFromImage(imageString)
    if not imageString or imageString == "" then return nil end
    return string.match(imageString, "id=(%d+)")
end

local function getUserImageFromSlot(surfaceGui, padNum, slotNum)
    if not surfaceGui then return nil, false end
    local firstFrame = surfaceGui:FindFirstChild("Frame")
    if not firstFrame then return nil, false end
    local padFrame = firstFrame:FindFirstChild(tostring(padNum))
    if not padFrame then return nil, false end
    local secondFrame = padFrame:FindFirstChild("Frame")
    if not secondFrame then return nil, false end
    local slotFrame = secondFrame:FindFirstChild(tostring(slotNum))
    if not slotFrame then return nil, false end
    
    local userImg = slotFrame:FindFirstChild("User")
    if userImg and userImg:IsA("ImageLabel") then
        local isActuallyVisible = slotFrame.Visible and userImg.Visible and (userImg.Image ~= "") and (userImg.ImageTransparency < 0.3)
        return userImg.Image, isActuallyVisible
    end
    return nil, false
end

local function getUsername(userId)
    if usernameCache[userId] then return usernameCache[userId] end
    local success, name = pcall(function() return Players:GetNameFromUserIdAsync(tonumber(userId)) end)
    if success and name then
        usernameCache[userId] = name
        return name
    end
    return "User_" .. tostring(userId)
end

