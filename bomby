-- Execute Flash Logic Function
local function triggerFlash()
    if not isInGame then return end
    
    FlashButton.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    task.delay(0.1, function()
        FlashButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end)

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local opponentsSource = next(currentOpponents) and currentOpponents or lastLoggedOpponents
    local targetsToFlash = {}

    if nearestOnlyEnabled then
        local nearestOpp = nil
        local shortestDist = math.huge
        
        for id, _ in pairs(opponentsSource) do
            local p = Players:GetPlayerByUserId(tonumber(id))
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestOpp = p
                    end
                end
            end
        end
        
        if nearestOpp then
            table.insert(targetsToFlash, nearestOpp)
        end
    else
        for id, _ in pairs(opponentsSource) do
            local p = Players:GetPlayerByUserId(tonumber(id))
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    table.insert(targetsToFlash, p)
                end
            end
        end
    end

    for _, p in ipairs(targetsToFlash) do
        if p.Name ~= LocalPlayer.Name then
            pcall(function()
                p.Character.HumanoidRootPart.Size = Vector3.new(99999, 99999, 99999)
                p.Character.HumanoidRootPart.Transparency = 1
                p.Character.HumanoidRootPart.BrickColor = BrickColor.new("White")
                p.Character.HumanoidRootPart.CanCollide = false
            end)
        end
    end

    task.delay(0.1, function()
        for _, p in ipairs(targetsToFlash) do
            resetHitbox(p)
        end
    end)
end

-- Fly and Noclip Logic Function
local function toggleFly()
    isFlying = not isFlying
    
    FlyButton.Text = isFlying and "Fly: on (Press E)" or "Fly: off (Press E)"
    FlyButton.BackgroundColor3 = isFlying and Color3.fromRGB(210, 210, 210) or Color3.fromRGB(255, 255, 255)

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if isFlying then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "FlyVelocity"
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = hrp

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "FlyGyro"
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp

        flyConnection = RunService.RenderStepped:Connect(function()
            if not isFlying or not char or not hrp or not hum then return end
            
            hum.PlatformStand = true
            local camera = Workspace.CurrentCamera
            local moveDir = Vector3.new(0, 0, 0)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveDir = moveDir - Vector3.new(0, 1, 0)
            end

            bodyVelocity.Velocity = moveDir * flySpeed
            bodyGyro.CFrame = camera.CFrame
        end)

        noclipConnection = RunService.Stepped:Connect(function()
            if not isFlying or not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        if flyConnection then flyConnection:Disconnect() flyConnection = nil end
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end

        if hum then
            hum.PlatformStand = false
        end

        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- Opponent-Only Bomb Steal: Sweeps only opponents holding the bomb, completely ignoring teammates
local function triggerBombSteal()
    if not isInGame then return end
    if isStealingActive then return end

    -- Do not run if you already have the bomb tool
    if hasBombTool() then
        lastTargetId = nil
        lastStolenSessionKey = nil
        return
    end

    BombTpButton.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    task.delay(0.1, function()
        BombTpButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end)

    -- Strictly use opponents source only
    local oppsSource = next(currentOpponents) and currentOpponents or lastLoggedOpponents

    local targetData = nil
    local foundHolderId = nil
    local currentBombHandle = nil

    for id, _ in pairs(oppsSource) do
        local player = Players:GetPlayerByUserId(tonumber(id))
        if player and player.Character then
            local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                for _, desc in ipairs(player.Character:GetDescendants()) do
                    if desc:IsA("BasePart") and desc.Name == "Handle" then
                        local parentModel = desc.Parent
                        if parentModel and parentModel:IsA("Model") then
                            local isHandleRequired = false
                            pcall(function()
                                if parentModel.RequireHandle == true then isHandleRequired = true end
                            end)

                            if isHandleRequired or desc then
                                targetData = {
                                    character = player.Character,
                                    rootPart = rootPart,
                                    originalCFrame = rootPart.CFrame
                                }
                                foundHolderId = id
                                currentBombHandle = desc
                                break
                            end
                        end
                    end
                end
            end
            if targetData then break end
        end
    end

    if not targetData or not foundHolderId or not currentBombHandle then return end

    local currentSessionKey = foundHolderId .. "_" .. tostring(currentBombHandle)
    if lastStolenSessionKey == currentSessionKey then return end

    isStealingActive = true
    lastTargetId = foundHolderId
    lastStolenSessionKey = currentSessionKey

    task.spawn(function()
        local startTime = tick()
        local flipState = false
        local lastToggle = tick()
        
        while not hasBombTool() and (tick() - startTime < 5) do
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then break end

            if tick() - lastToggle >= 0.05 then
                flipState = not flipState
                lastToggle = tick()
            end

            pcall(function()
                if flipState then
                    local faceYouCFrame = (myRoot.CFrame * CFrame.new(-1.2, 0, 1.0)) * CFrame.Angles(0, math.pi, 0)
                    targetData.rootPart.CFrame = faceYouCFrame
                else
                    local faceAwayCFrame = myRoot.CFrame * CFrame.new(-1.2, 0, 2.2)
                    targetData.rootPart.CFrame = faceAwayCFrame
                end
                
                if targetData.character:FindFirstChildOfClass("Humanoid") then
                    targetData.character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
            
            RunService.Heartbeat:Wait()
        end

        pcall(function()
            if targetData.rootPart and targetData.rootPart.Parent then
                targetData.rootPart.CFrame = targetData.originalCFrame
            end
        end)

        isStealingActive = false
    end)
end

-- Constantly check if bomb state refreshed or changed hands
task.spawn(function()
    while task.wait(0.2) do
        if hasBombTool() then
            lastStolenSessionKey = nil
            lastTargetId = nil
        else
            if lastTargetId then
                local holderFound = false
                local oppsSource = next(currentOpponents) and currentOpponents or lastLoggedOpponents
                if oppsSource[lastTargetId] then
                    local player = Players:GetPlayerByUserId(tonumber(lastTargetId))
                    if player and player.Character then
                        for _, desc in ipairs(player.Character:GetDescendants()) do
                            if desc:IsA("BasePart") and desc.Name == "Handle" then
                                holderFound = true
                                break
                            end
                        end
                    end
                end
                if not holderFound then
                    lastTargetId = nil
                    lastStolenSessionKey = nil
                end
            end
        end
    end
end)

