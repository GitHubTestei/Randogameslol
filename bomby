-- Clear ESP highlights & Bomb highlights
local function clearHighlights()
    for _, h in pairs(matchHighlights) do
        if h then h:Destroy() end
    end
    matchHighlights = {}

    for _, h in pairs(bombHighlights) do
        if h then h:Destroy() end
    end
    bombHighlights = {}
end

local function updateHighlights()
    if not isInGame then
        clearHighlights()
        return
    end

    local activeIds = {}
    for id,_ in pairs(currentTeammates) do activeIds[id] = Color3.fromRGB(0, 255, 100) end
    for id,_ in pairs(currentOpponents) do activeIds[id] = Color3.fromRGB(255, 50, 50) end

    -- Player ESP Highlights
    for id, color in pairs(activeIds) do
        local player = Players:GetPlayerByUserId(tonumber(id))
        if player and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local char = player.Character
                local hl = matchHighlights[id]
                if not hl or hl.Parent ~= char then
                    if hl then hl:Destroy() end
                    hl = Instance.new("Highlight")
                    hl.Name = "TrackerHighlight"
                    hl.Adornee = char
                    hl.FillColor = color
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.4
                    hl.OutlineTransparency = 0
                    hl.Parent = char
                    matchHighlights[id] = hl
                else
                    hl.FillColor = color
                end
            else
                local hl = matchHighlights[id]
                if hl then hl:Destroy() matchHighlights[id] = nil end
            end
        end
    end

    -- Bomb ESP Highlights (Blue for match participants only)
    local currentMatchPlayers = {}
    for id,_ in pairs(currentTeammates) do currentMatchPlayers[id] = true end
    for id,_ in pairs(currentOpponents) do currentMatchPlayers[id] = true end

    for _, h in pairs(bombHighlights) do if h then h:Destroy() end end
    bombHighlights = {}

    for id, _ in pairs(currentMatchPlayers) do
        local player = Players:GetPlayerByUserId(tonumber(id))
        if player and player.Character then
            for _, desc in ipairs(player.Character:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Name == "Handle" then
                    local parentModel = desc.Parent
                    if parentModel and parentModel:IsA("Model") then
                        local isHandleRequired = false
                        pcall(function()
                            if parentModel.RequireHandle == true then isHandleRequired = true end
                        end)

                        if isHandleRequired or desc then
                            local bHL = Instance.new("Highlight")
                            bHL.Name = "BombHighlight"
                            bHL.Adornee = parentModel
                            bHL.FillColor = Color3.fromRGB(0, 150, 255)
                            bHL.OutlineColor = Color3.fromRGB(255, 255, 255)
                            bHL.FillTransparency = 0.3
                            bHL.OutlineTransparency = 0
                            bHL.Parent = parentModel
                            table.insert(bombHighlights, bHL)
                        end
                    end
                end
            end
        end
    end
end

local function resetHitbox(p)
    if p and p.Character then
        local root = p.Character:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = true
                root.Shape = Enum.PartType.Block
            end)
        end
    end
end

