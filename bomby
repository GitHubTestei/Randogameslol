-- Teleport & Game State Checker Loop
local lastPos = nil
task.spawn(function()
    while true do
        task.wait(1)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if lastPos then
                local distMoved = (hrp.Position - lastPos).Magnitude
                if distMoved > 900 then -- Teleported
                    isInGame = not isInGame
                    
                    if isInGame then
                        if not next(currentTeammates) and next(lastLoggedTeammates) then
                            currentTeammates = lastLoggedTeammates
                        end
                        if not next(currentOpponents) and next(lastLoggedOpponents) then
                            currentOpponents = lastLoggedOpponents
                        end
                    else
                        currentTeammates = {}
                        currentOpponents = {}
                        currentBoard = nil
                        clearHighlights()
                        lastTargetId = nil
                        lastStolenSessionKey = nil
                        isStealingActive = false
                    end
                    
                    updateUI()
                end
            end
            lastPos = hrp.Position
        end
    end
end)

-- Main Lobby Board Scanning Loop
local function scanLobbyBoards()
    if isInGame then return end
    
    local myUserId = tostring(LocalPlayer.UserId)
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    local physicalLobby = workspace:FindFirstChild("_Lobby") and workspace._Lobby:FindFirstChild("_Physical")
    if not physicalLobby then return end

    local bestBoard = nil
    local bestPad = nil
    local shortestDistance = math.huge

    for boardNum, maxSlots in pairs(BOARD_SLOTS) do
        local boardFolder = physicalLobby:FindFirstChild(boardNum)
        if not boardFolder then continue end
        local boardModel = boardFolder:FindFirstChild("Board")
        if not boardModel then continue end
        local boardPhysicalPart = boardModel:FindFirstChild("Board")
        if not boardPhysicalPart then continue end
        local surfaceGui = boardPhysicalPart:FindFirstChild("SurfaceGui")
        if not surfaceGui then continue end
        
        local dist = math.huge
        if myHRP and boardPhysicalPart:IsA("BasePart") then
            dist = (myHRP.Position - boardPhysicalPart.Position).Magnitude
        end

        for padNum = 1, 2 do
            for slotNum = 1, maxSlots do
                local imageStr, isVisible = getUserImageFromSlot(surfaceGui, padNum, slotNum)
                local id = getUserIdFromImage(imageStr)
                
                if id == myUserId and isVisible then
                    if dist < shortestDistance then
                        shortestDistance = dist
                        bestBoard = boardNum
                        bestPad = padNum
                    end
                end
            end
        end
    end

    if shortestDistance > 45 then
        bestBoard = nil
        bestPad = nil
    end

    local newTeammates = {}
    local newOpponents = {}

    if bestBoard and bestPad then
        local enemyPad = (bestPad == 1) and 2 or 1
        local maxSlots = BOARD_SLOTS[bestBoard]
        local surfaceGui = physicalLobby[bestBoard].Board.Board.SurfaceGui

        for padNum = 1, 2 do
            local targetTable = (padNum == bestPad) and newTeammates or newOpponents
            for slotNum = 1, maxSlots do
                local imageStr, isVisible = getUserImageFromSlot(surfaceGui, padNum, slotNum)
                if isVisible then
                    local id = getUserIdFromImage(imageStr)
                    if id and id ~= myUserId then
                        targetTable[id] = true
                    end
                end
            end
        end
    end

    local dataChanged = false
    if currentBoard ~= bestBoard then dataChanged = true end
    
    if not dataChanged then
        for id,_ in pairs(newTeammates) do if not currentTeammates[id] then dataChanged = true break end end
        for id,_ in pairs(currentTeammates) do if not newTeammates[id] then dataChanged = true break end end
        for id,_ in pairs(newOpponents) do if not currentOpponents[id] then dataChanged = true break end end
        for id,_ in pairs(currentOpponents) do if not newOpponents[id] then dataChanged = true break end end
    end

    if dataChanged then
        currentTeammates = newTeammates
        currentOpponents = newOpponents
        currentBoard = bestBoard
        
        if next(newTeammates) or next(newOpponents) then
            lastLoggedTeammates = {}
            for id,_ in pairs(newTeammates) do lastLoggedTeammates[id] = true end
            
            lastLoggedOpponents = {}
            for id,_ in pairs(newOpponents) do lastLoggedOpponents[id] = true end
        end
        
        updateUI()
    end
end

updateUI()

task.spawn(function()
    while task.wait(1) do
        scanLobbyBoards()
    end
end)

RunService.RenderStepped:Connect(function()
    updateHighlights()
end)
