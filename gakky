    TabLabel.BackgroundTransparency = 1
    TabLabel.Text = tabName
    TabLabel.TextColor3 = Color3.fromRGB(110, 110, 120)
    TabLabel.Font = Enum.Font.GothamBold
    TabLabel.TextSize = 11
    TabLabel.Parent = TabButton

    local function showPage(name)
        for _, p in pairs(Pages) do p.Visible = false end
        if Pages[name] then Pages[name].Visible = true end
    end

    local activeIndicator = Instance.new("Frame")
    activeIndicator.Size = UDim2.new(0, 3, 0, 16)
    activeIndicator.BackgroundColor3 = _G.CurrentThemeColor
    activeIndicator.BorderSizePixel = 0
    activeIndicator.Parent = Sidebar

    if tabName == "MAIN" then
        TabLabel.TextColor3 = Color3.fromRGB(30, 30, 40)
        activeIndicator.Position = UDim2.new(0, 0, 0, (i - 1) * 32 + 8)
        showPage("MAIN")
    else
        activeIndicator.Position = UDim2.new(0, 0, 0, (i - 1) * 32 + 8)
        activeIndicator.Visible = false
    end

    TabButton.MouseButton1Click:Connect(function()
        showPage(tabName)
        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("Frame") and child ~= SidebarLine then
                child.Visible = (child.Position.Y.Offset == (i - 1) * 32 + 8)
            end
        end
        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("TextButton") then
