local function FindObjectNearby()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if string.find(name, "chair") or string.find(name, "cube_006") or string.find(name, "cube_003") then
                if (obj.Position - root.Position).Magnitude <= 15 then
                    return true
                end
            end
        end
    end
    return false
end

local flying = false
local flyConnection

local function ToggleFly(enable)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if enable and not flying then
        flying = true
        hum.PlatformStand = true
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "IYFlyVelocity"
        bv.Parent = root
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.new(0, 0, 0)

        local bg = Instance.new("BodyGyro")
        bg.Name = "IYFlyGyro"
        bg.Parent = root
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = root.CFrame

        flyConnection = RunService.RenderStepped:Connect(function()
            if not flying or not root or not hum then return end
            bv.Velocity = Vector3.new(0, 0, 0)
            bg.CFrame = workspace.CurrentCamera.CFrame
        end)
    elseif not enable and flying then
        flying = false
        if flyConnection then flyConnection:Disconnect() end
        if root:FindFirstChild("IYFlyVelocity") then root.IYFlyVelocity:Destroy() end
        if root:FindFirstChild("IYFlyGyro") then root.IYFlyGyro:Destroy() end
        hum.PlatformStand = false
    end
end

local HealBtn -- forward declaration
local function TriggerHeal()
    if isTestFixRunning then return end
    isTestFixRunning = true
    if HealBtn then HealBtn.Text = "HEALING..." end

    task.spawn(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not root then
            if HealBtn then HealBtn.Text = "HEAL" end
            isTestFixRunning = false
            return
        end

        if _G.HealNoRenderEnabled then
            RunService:Set3dRenderingEnabled(false)
            HealStatusText.Visible = true
        end

        local originalCFrame = root.CFrame
        local targetCF = CFrame.new(-58.0587349, 151.641846, 164.639557) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0.11583408, 0.00236671767, 0.993265748), Vector3.new(0.978073835, 0.173973069, -0.114476942), Vector3.new(-0.173072428, 0.984747589, 0.0178371873))

        root.CFrame = targetCF

        local startTime = tick()
        local finished = false

        while not finished do
            task.wait(0.2)
            if tick() - startTime > 25 then break end
            if FindObjectNearby() then
                finished = true
            end
        end

        task.wait(0.3)

        local returnChar = LocalPlayer.Character
        local returnRoot = returnChar and returnChar:FindFirstChild("HumanoidRootPart")
        local returnHum = returnChar and returnChar:FindFirstChildOfClass("Humanoid")
        if returnRoot then
            if returnHum then
                returnHum.Sit = false
                returnHum.PlatformStand = false
            end
            returnRoot.CFrame = originalCFrame
        end

        ToggleFly(true)
        task.wait(0.05)
        ToggleFly(false)

        if _G.HealNoRenderEnabled then
            RunService:Set3dRenderingEnabled(true)
            HealStatusText.Visible = false
        end

        if HealBtn then HealBtn.Text = "HEAL" end
        isTestFixRunning = false
    end)
end

