local function ManagePlayerESP(player, character)
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local tag = ESPFolder:FindFirstChild(player.Name)
    if not tag then
        tag = Instance.new("Folder")
        tag.Name = player.Name
        tag.Parent = ESPFolder

        local high = Instance.new("Highlight")
        high.Name = "Box"
        high.FillTransparency = 1
        high.OutlineColor = _G.CurrentThemeColor
        high.OutlineTransparency = 0.2
        high.Adornee = character
        high.Parent = tag

        local bb = Instance.new("BillboardGui")
        bb.Name = "Interface"
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.AlwaysOnTop = true
        bb.ExtentsOffset = Vector3.new(0, 3, 0)
        bb.Adornee = root
        bb.Parent = tag

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "PlayerName"
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 12
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.Text = player.Name
        nameLabel.Parent = bb

        local healthBarBg = Instance.new("Frame")
        healthBarBg.Name = "HealthBarBg"
        healthBarBg.Size = UDim2.new(0, 100, 0, 6)
        healthBarBg.Position = UDim2.new(0.5, -50, 0, 22)
        healthBarBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        healthBarBg.BorderSizePixel = 0
        healthBarBg.Parent = bb

        local healthBar = Instance.new("Frame")
        healthBar.Name = "HealthBar"
        healthBar.Size = UDim2.new(1, 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        healthBar.BorderSizePixel = 0
        healthBar.Parent = healthBarBg
    end

    if tag:FindFirstChild("Box") then
        tag.Box.Enabled = _G.ESPBoxEnabled
        tag.Box.Adornee = character
    end

    if tag:FindFirstChild("Interface") then
        local bb = tag.Interface
        bb.Adornee = root
        local nameLbl = bb:FindFirstChild("PlayerName")
        local healthBg = bb:FindFirstChild("HealthBarBg")
        if nameLbl then nameLbl.Visible = _G.ESPNameEnabled end
        if healthBg then healthBg.Visible = _G.ESPHealthEnabled end

        if healthBg and healthBg:FindFirstChild("HealthBar") then
            local bar = healthBg.HealthBar
            local percent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            bar.Size = UDim2.new(percent, 0, 1, 0)
        end
    end
end

local function FaceTarget(enemyRoot)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myRoot and enemyRoot and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(enemyRoot.Position.X, myRoot.Position.Y, enemyRoot.Position.Z))
    end
end

local isResponding = false
local function TriggerParry(timing, isCombo, enemyRoot)
    task.spawn(function()
        local totalDelay = timing.delay + (_G.ParryDelayMs / 1000)
        if totalDelay > 0 then task.wait(totalDelay) end
        
        if _G.AutoParryActive then
            FaceTarget(enemyRoot)
            local dur = (_G.BlockDurationMs / 1000)
            
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(dur)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end
        if not isCombo then task.wait(timing.cooldown) end
        isResponding = false
    end)
end

local function TriggerEvade(timing, isCombo, enemyRoot)
    task.spawn(function()
        local totalDelay = timing.delay + (_G.ParryDelayMs / 1000)
        if totalDelay > 0 then task.wait(totalDelay) end
        if _G.AutoParryActive then
            FaceTarget(enemyRoot)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.S, false, game)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.A, false, game)
            task.wait(isCombo and 0.10 or timing.cooldown)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.S, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.A, false, game)
        end
        isResponding = false
    end)
end

-- === NETWORK LOGIC ===
local CombatEvent = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Network") and ReplicatedStorage.Shared.Network:FindFirstChild("CombatBroadcastURE")
if CombatEvent then
    _G.NetworkParryConnection = CombatEvent.OnClientEvent:Connect(function(actionType, p1, p2)
        if not _G.AutoParryActive or isResponding then return end
        local attackerName = tostring(p1)
        if attackerName == LocalPlayer.Name then attackerName = tostring(p2) end
        if attackerName == LocalPlayer.Name then return end 
        
        local attacker = Players:FindFirstChild(attackerName)
        if attacker and attacker.Character then
            local enemyRoot = attacker.Character:FindFirstChild("HumanoidRootPart")
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if enemyRoot and myRoot and (enemyRoot.Position - myRoot.Position).Magnitude < 18 then
                if actionType == "WrestlingM2SlamCrater" or actionType == "WrestlingM2GrabEnd" then
                    isResponding = true
                    TriggerEvade(StyleTimings.Heavy, true, enemyRoot) 
                elseif actionType == "M2Hit" then
                    isResponding = true
                    TriggerEvade(StyleTimings.Heavy, false, enemyRoot)
                end
            end
        end
    end)
end

_G.AutoParryConnection = RunService.Heartbeat:Connect(function()
    if not _G.AutoParryActive or isResponding then return end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position

    local enemyNear = false
    local isCombo = false
    local attackType = "Default"
    local targetEnemyRoot = nil

    for i = 1, #PlayerCache do
        local p = PlayerCache[i]
        local enemyChar = p.Character
        if enemyChar then
            local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
            local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")
            if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 and (enemyRoot.Position - myPos).Magnitude < 18 then
                local isPlayingAttackAnimation = false
                local animator = enemyHumanoid:FindFirstChildOfClass("Animator")
                if animator then
                    pcall(function()
                        local tracks = animator:GetPlayingAnimationTracks()
                        if tracks then
                            for j = 1, #tracks do
                                local track = tracks[j]
                                if track and track.Name then
                                    local animName = track.Name:lower()
                                    if string.find(animName, "akari") then attackType = "Akari"; isPlayingAttackAnimation = true; break
                                    elseif string.find(animName, "boxing") or string.find(animName, "boxe") then attackType = "Boxing"; isPlayingAttackAnimation = true; break
                                    elseif string.find(animName, "m2") or string.find(animName, "heavy") or string.find(animName, "break") then attackType = "Heavy"; isPlayingAttackAnimation = true; break
                                    elseif string.find(animName, "fast") or string.find(animName, "fist") then attackType = "Fast"; isPlayingAttackAnimation = true; break
                                    elseif string.find(animName, "attack") or string.find(animName, "m1") or string.find(animName, "swing") or string.find(animName, "punch") then attackType = "Default"; isPlayingAttackAnimation = true; break
                                    end
                                end
                            end
                        end
                    end)
                end

                local genericAttack = enemyChar:GetAttribute("CombatAttacking") == true or enemyChar:GetAttribute("Attacking") == true
                local hitting = enemyChar:GetAttribute("Combo") or enemyChar:GetAttribute("InCombo") or enemyChar:GetAttribute("IsComboing")
                if hitting or (genericAttack and attackType == "Fast") then isCombo = true end

                if isPlayingAttackAnimation or genericAttack then
                    enemyNear = true
                    targetEnemyRoot = enemyRoot
                    break
                end
            end
        end
    end

    if enemyNear and targetEnemyRoot then
        isResponding = true
        local timing = StyleTimings[attackType]
        if attackType == "Heavy" then
            TriggerEvade(timing, isCombo, targetEnemyRoot)
        else
            TriggerParry(timing, isCombo, targetEnemyRoot)
        end
    end

    if _G.CustomMaxZoom then
        pcall(function()
            if LocalPlayer.CameraMaxZoomDistance ~= _G.CustomMaxZoom then
                LocalPlayer.CameraMaxZoomDistance = _G.CustomMaxZoom
            end
        end)
    end
end)

